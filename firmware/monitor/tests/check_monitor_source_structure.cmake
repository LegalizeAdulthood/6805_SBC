if(NOT DEFINED MONITOR_SOURCE)
    message(FATAL_ERROR "MONITOR_SOURCE is required")
endif()

if(NOT EXISTS "${MONITOR_SOURCE}")
    message(FATAL_ERROR "monitor source does not exist: ${MONITOR_SOURCE}")
endif()

file(STRINGS "${MONITOR_SOURCE}" source_lines)

set(active_module "")
set(seen_modules "")
set(errors "")
set(line_no 0)

foreach(line IN LISTS source_lines)
    math(EXPR line_no "${line_no} + 1")

    if(line MATCHES "^[ \t]*\\.module[ \t]+([A-Za-z_][A-Za-z0-9_]*)")
        set(active_module "${CMAKE_MATCH_1}")
        list(APPEND seen_modules "${active_module}")
    endif()

    if(line MATCHES "^([A-Za-z_][A-Za-z0-9_]*):")
        set(label "${CMAKE_MATCH_1}")
        if(active_module STREQUAL "")
            list(APPEND errors "label '${label}' at line ${line_no} appears before any .module")
        endif()
        set("label_module_${label}" "${active_module}")
    endif()

    if(line MATCHES "^[ \t]*\\.org[ \t]+\\$1ff6")
        if(NOT active_module STREQUAL "int_vecs")
            list(APPEND errors ".org $1ff6 at line ${line_no} must be in module 'int_vecs'")
        endif()
    endif()
endforeach()

macro(require_module module)
    list(FIND seen_modules "${module}" module_index)
    if(module_index EQUAL -1)
        list(APPEND errors "missing required module '${module}'")
    endif()
endmacro()

macro(forbid_module module)
    list(FIND seen_modules "${module}" module_index)
    if(NOT module_index EQUAL -1)
        list(APPEND errors "production monitor source must not include test-only module '${module}'")
    endif()
endmacro()

macro(require_label_module label module)
    if(NOT DEFINED label_module_${label})
        list(APPEND errors "missing required label '${label}'")
    elseif(NOT "${label_module_${label}}" STREQUAL "${module}")
        list(APPEND errors "label '${label}' is in module '${label_module_${label}}', expected '${module}'")
    endif()
endmacro()

macro(forbid_label label)
    if(DEFINED label_module_${label})
        list(APPEND errors "production monitor source must not include test-only label '${label}'")
    endif()
endmacro()

require_module("reset")
require_module("int_disp")
require_module("con_io")
require_module("draw_boot")
require_module("draw_cpu")
require_module("scr_out")
require_module("dasm_out")
