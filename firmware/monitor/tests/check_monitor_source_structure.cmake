require_module("mem_pnl")
require_module("mem_edit")
require_module("mem_cur")
require_module("asm_cmd")
require_module("idle")
require_module("data")

forbid_module("test_hooks")
forbid_label("test_con_out")
forbid_label("test_cpu_out")
forbid_label("test_mem_out")
forbid_label("test_dasm_out")

require_label_module("reset" "reset")
require_label_module("swi" "int_disp")
require_label_module("tmr_disp" "int_disp")
require_label_module("ext_disp" "int_disp")
require_label_module("init_con" "con_io")
require_label_module("chrout" "con_io")
require_label_module("draw_boot" "draw_boot")
require_label_module("draw_cpu" "draw_cpu")
require_label_module("emit_spcs" "scr_out")
require_label_module("dec_inst" "dasm_out")
require_label_module("dasm_line" "dasm_out")
require_label_module("hex_byte" "hex_out")
require_label_module("draw_mem_row" "draw_mem_row")
require_label_module("draw_dasm_row" "draw_dasm_row")
require_label_module("init_mem_pnl" "mem_pnl")
